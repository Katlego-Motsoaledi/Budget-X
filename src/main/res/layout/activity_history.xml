<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1220"
    android:padding="16dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Expense History"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterDate"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Filter"
            android:textAllCaps="false"
            app:cornerRadius="20dp"
            app:backgroundTint="#38BDF8"
            android:textColor="#0B1220"/>
    </LinearLayout>

    <!-- SUMMARY CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#111C33"
        android:padding="16dp"
        android:elevation="6dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category Summary"
            android:textSize="14sp"
            android:textColor="#94A3B8"/>

        <TextView
            android:id="@+id/tvCategorySummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select a date range to see totals"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <!-- STATS MINI CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#111C33"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvHistoryStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 Streak: 0"
            android:textColor="#FBBF24"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="   |   "
            android:textColor="#64748B"/>

        <TextView
            android:id="@+id/tvHistoryInsight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep saving!"
            android:textColor="#94A3B8"/>
    </LinearLayout>

    <!-- LIST CARD (FIXED) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#111C33"
        android:elevation="6dp"
        android:padding="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"/>
    </LinearLayout>

</LinearLayout>